---
import type { Faq } from '../data/services';

interface Props {
  items: readonly Faq[];
  title?: string;
}
const { items, title = 'Questions' } = Astro.props;
---

<section class="faq">
  <h2>{title}</h2>
  <div>
    {
      items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
