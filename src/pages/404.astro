---
import EndCta from '../components/EndCta.astro';
import Base from '../layouts/Base.astro';

const title = 'Page not found | ClearFix';
const description = 'That page is not on the ClearFix site. Go home or call 07345 678795.';
---

<Base title={title} description={description} noindex={true}>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">
        The link may be old. You can go back to the <a href="/">home page</a>, see
        <a href="/services">services</a>, or call 07345 678795.
      </p>
      <EndCta heading="Or just call." />
    </div>
  </header>
</Base>
